# ==========================================
# Job Match Engine Environment Configuration
# ==========================================

# Gmail API OAuth2 Credentials
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token_here

# Job Board Provider API Keys
INDEED_API_KEY=your_indeed_publisher_api_key_here
ZIPRECRUITER_API_KEY=your_ziprecruiter_api_key_here
DICE_API_KEY=your_dice_api_key_here

# Output Settings
OUTPUT_FORMAT=json # Options: json, csv
LOG_LEVEL=info
