PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/portfolio

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key

# Third-party Integrations
GITHUB_TOKEN=your_github_personal_access_token

# AI Provider Credentials
AI_PROVIDER_KEY=your_openai_or_gemini_api_key

# Seeding Initial Admin
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=adminPassword123
